@model RegisterViewModel

<h2>Register</h2>

<form asp-action="Register" method="post">
    <input asp-for="Email" placeholder="Email" class="form-control mb-2" />
    <input asp-for="Password" type="password" placeholder="Password" class="form-control mb-2" />
    <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" class="form-control mb-2" />

    <button type="submit" class="btn btn-primary">Register</button>
</form>

<div asp-validation-summary="All" class="text-danger"></div>