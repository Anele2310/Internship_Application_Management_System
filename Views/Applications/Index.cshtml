@model IEnumerable<Application>

<h2>Applications</h2>

<table class="table">
    <tr>
        <th>Internship</th>
        <th>User</th>
        <th>Date</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Internship.Title</td>
            <td>@item.UserId</td>
            <td>@item.AppliedDate</td>
        </tr>
    }
</table>