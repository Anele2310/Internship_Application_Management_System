@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-5">
    <h1>Welcome to Internship Portal</h1>
    <p class="lead">Find and apply for internships </p>

    <a asp-controller="Internships" asp-action="Index" class="btn btn-primary mt-3">
        View Internships
    </a>
    <h2 class="mb-4">Admin Dashboard</h2>

    <div class="row">
        <div class="col-md-4">
            <div class="card text-center shadow p-3">
                <h3>10</h3>
                <p>Total Internships</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center shadow p-3">
                <h3>2</h3>
                <p>Applications</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center shadow p-3">
                <h3>5</h3>
                <p>Active Companies</p>
            </div>
        </div>
    </div>
</div>
